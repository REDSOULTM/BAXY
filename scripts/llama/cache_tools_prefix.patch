+// ---------------------------------------------------------------------------------------------------------------------
+// BAXY Renew (cache_tools_prefix.patch): the tokens of a prompt's start, kept between requests.
+//
+// With special tokens parsed, llama_vocab::impl::tokenize first splits the text at every special token
+// (tokenizer_st_partition) and then tokenizes each piece between them on its own. So a text cut right after a special
+// token S tokenizes as the tokens up to S followed by the tokens of the rest, provided no other special token can match
+// across the cut (no special token holds an end of S followed by more text) and S strips no whitespace around it. Such
+// cuts are recorded while each kept text's tokens are checked piece by piece against the text; a new prompt takes the
+// kept tokens up to the last cut inside the start it shares with a kept text and tokenizes only the rest. Only for BPE
+// vocabularies, special tokens parsed, no BOS/EOS added and texts of at least 4 KiB.
+namespace {
+
+struct prompt_cut {
+    size_t offset;   // text offset right after a special token
+    size_t n_tokens; // tokens up to and including it
+};
+
+struct prompt_entry {
+    std::string             text;
+    llama_tokens            tokens;
+    std::vector<prompt_cut> cuts; // ascending
+};
+
+struct prompt_token_cache {
+    std::mutex                            mutex;
+    const llama_vocab *                   vocab = nullptr;
+    std::unordered_map<llama_token, bool> cut_after; // special token -> whether a cut may follow it
+    std::vector<std::string>              specials;  // the texts of all special tokens
+    std::list<prompt_entry>               entries;   // most recently used first
+};
+
+constexpr size_t PROMPT_CACHE_MIN_TEXT = 4096;
+constexpr size_t PROMPT_CACHE_ENTRIES  = 8;
+
+prompt_token_cache & prompt_tokens_cache() {
+    static prompt_token_cache cache;
+    return cache;
+}
+
+bool prompt_special_attr(llama_token_attr attr) {
+    // the tokens tokenizer_st_partition splits at (llama-vocab.cpp, cache_special_tokens)
+    return attr & (LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED | LLAMA_TOKEN_ATTR_UNKNOWN);
+}
+
+// whether a cut may follow the special token `id`; cache.mutex held
+bool prompt_may_cut_after(prompt_token_cache & cache, const llama_vocab * vocab, llama_token id) {
+    const auto known = cache.cut_after.find(id);
+    if (known != cache.cut_after.end()) {
+        return known->second;
+    }
+    const llama_token_attr attr = llama_vocab_get_attr(vocab, id);
+    const std::string      s    = llama_vocab_get_text(vocab, id);
+    bool ok = prompt_special_attr(attr) && !(attr & (LLAMA_TOKEN_ATTR_LSTRIP | LLAMA_TOKEN_ATTR_RSTRIP)) && !s.empty();
+    if (ok && cache.specials.empty()) {
+        const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+        for (llama_token t = 0; t < n_vocab; t++) {
+            if (prompt_special_attr(llama_vocab_get_attr(vocab, t))) {
+                cache.specials.emplace_back(llama_vocab_get_text(vocab, t));
+            }
+        }
+    }
+    for (size_t i = 0; ok && i < cache.specials.size(); i++) {
+        const std::string & t = cache.specials[i];
+        if (t == s) {
+            continue;
+        }
+        for (size_t k = 1; ok && k <= s.size(); k++) {
+            const std::string tail = s.substr(s.size() - k);
+            for (size_t pos = t.find(tail); pos != std::string::npos; pos = t.find(tail, pos + 1)) {
+                if (pos + k < t.size()) {
+                    ok = false; // t could start inside s (or before it) and end after the cut
+                    break;
+                }
+            }
+        }
+    }
+    cache.cut_after[id] = ok;
+    return ok;
+}
+
+// appends the cuts among tokens[from..], whose text starts at `offset` in `text`; false when the tokens' pieces do not
+// give back the text byte for byte; cache.mutex held
+bool prompt_add_cuts(prompt_token_cache & cache, const llama_vocab * vocab, const std::string & text,
+                     const llama_tokens & tokens, size_t from, size_t offset, std::vector<prompt_cut> & cuts) {
+    std::vector<char> piece(256);
+    for (size_t i = from; i < tokens.size(); i++) {
+        int32_t n = llama_token_to_piece(vocab, tokens[i], piece.data(), (int32_t) piece.size(), 0, true);
+        if (n < 0) {
+            piece.resize(-n);
+            n = llama_token_to_piece(vocab, tokens[i], piece.data(), (int32_t) piece.size(), 0, true);
+        }
+        if (n < 0 || offset + n > text.size() || (n > 0 && memcmp(text.data() + offset, piece.data(), n) != 0)) {
+            return false;
+        }
+        offset += n;
+        if (prompt_special_attr(llama_vocab_get_attr(vocab, tokens[i])) && prompt_may_cut_after(cache, vocab, tokens[i])) {
+            cuts.push_back({ offset, i + 1 });
+        }
+    }
+    return offset == text.size();
+}
+
+} // namespace
+
+llama_tokens server_tokenize_prompt(const llama_vocab * vocab, const std::string & text, bool add_special, bool parse_special) {
+    if (!common_baxy_cache_enabled() || !parse_special || text.size() < PROMPT_CACHE_MIN_TEXT ||
+            llama_vocab_type(vocab) != LLAMA_VOCAB_TYPE_BPE ||
+            (add_special && (llama_vocab_get_add_bos(vocab) || llama_vocab_get_add_eos(vocab)))) {
+        return common_tokenize(vocab, text, add_special, parse_special);
+    }
+    auto & cache = prompt_tokens_cache();
+
+    llama_tokens            tokens;
+    std::vector<prompt_cut> cuts;
+    size_t                  offset = 0;
+    std::string             source; // the kept text the start comes from
+    {
+        std::lock_guard<std::mutex> lock(cache.mutex);
+        if (cache.vocab != vocab) {
+            cache.vocab = vocab;
+            cache.entries.clear();
+            cache.cut_after.clear();
+            cache.specials.clear();
+        }
+        const prompt_entry * best     = nullptr;
+        const prompt_cut   * best_cut = nullptr;
+        for (const auto & entry : cache.entries) {
