+// BAXY Renew (cache_tools_prefix.patch): the same text as value_to_json_internal, appended to a string instead of
+// written character by character to a stream (a tool list's `tool | tojson` was most of a template's render)
+static void value_to_json_append(std::string & out, const value & val, int curr_lvl, int indent, const std::string_view item_sep, const std::string_view key_sep);
+
+static void value_to_json_append_string(std::string & out, const std::string & str) {
+    out += '"';
+    for (char c : str) {
+        switch (c) {
+            case '"': out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\b': out += "\\b"; break;
+            case '\f': out += "\\f"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default:
+                if (static_cast<unsigned char>(c) < 0x20) {
+                    char buf[7];
+                    snprintf(buf, sizeof(buf), "\\u%04x", static_cast<unsigned char>(c));
+                    out += buf;
+                } else {
+                    out += c;
+                }
+        }
+    }
+    out += '"';
+}
+
+static void value_to_json_append(std::string & out, const value & val, int curr_lvl, int indent, const std::string_view item_sep, const std::string_view key_sep) {
+    auto indent_str = [&out, indent](int lvl) {
+        if (indent > 0) {
+            out.append((size_t) lvl * indent, ' ');
+        }
+    };
+    auto newline = [&out, indent]() {
+        if (indent >= 0) {
+            out += '\n';
+        }
+    };
+
+    if (is_val<value_none>(val) || val->is_undefined()) {
+        out += "null";
+    } else if (is_val<value_bool>(val)) {
+        out += (val->as_bool() ? "true" : "false");
+    } else if (is_val<value_int>(val)) {
+        std::ostringstream oss; // numbers as the stream writes them
+        oss << val->as_int();
+        out += oss.str();
+    } else if (is_val<value_float>(val)) {
+        std::ostringstream oss;
+        oss << val->as_float();
+        out += oss.str();
+    } else if (is_val<value_string>(val)) {
+        value_to_json_append_string(out, val->as_string().str());
+    } else if (is_val<value_array>(val)) {
+        const auto & arr = val->as_array();
+        out += '[';
+        if (!arr.empty()) {
+            newline();
+            for (size_t i = 0; i < arr.size(); ++i) {
+                indent_str(curr_lvl + 1);
+                value_to_json_append(out, arr[i], curr_lvl + 1, indent, item_sep, key_sep);
+                if (i < arr.size() - 1) {
+                    out += item_sep;
+                }
+                newline();
+            }
+            indent_str(curr_lvl);
+        }
+        out += ']';
+    } else if (is_val<value_object>(val)) {
+        const auto & obj = val->as_ordered_object(); // IMPORTANT: need to keep exact order
+        out += '{';
+        if (!obj.empty()) {
+            newline();
+            size_t i = 0;
+            for (const auto & pair : obj) {
+                indent_str(curr_lvl + 1);
+                value_to_json_append_string(out, pair.first->as_string().str());
+                out += key_sep;
+                value_to_json_append(out, pair.second, curr_lvl + 1, indent, item_sep, key_sep);
+                if (i < obj.size() - 1) {
+                    out += item_sep;
+                }
+                newline();
+                ++i;
+            }
+            indent_str(curr_lvl);
+        }
+        out += '}';
+    } else {
+        out += "null";
+    }
+}
+
 std::string value_to_json(const value & val, int indent, const std::string_view item_sep, const std::string_view key_sep) {
+    if (common_baxy_cache_enabled()) {
+        std::string out;
+        value_to_json_append(out, val, 0, indent, item_sep, key_sep);
+        if (common_baxy_cache_check()) {
+            std::ostringstream oss;
+            value_to_json_internal(oss, val, 0, indent, item_sep, key_sep);
+            if (oss.str() != out) {
+                fprintf(stderr, "value_to_json: BAXY cache check: JSON text differs from stock, using stock\n");
+                return oss.str();
+            }
+        }
+        JJ_DEBUG("value_to_json: result=%s", out.c_str());
+        return out;
+    }
     std::ostringstream oss;
     value_to_json_internal(oss, val, 0, indent, item_sep, key_sep);
     JJ_DEBUG("value_to_json: result=%s", oss.str().c_str());
