<Project>
  <PropertyGroup>
    <BaxyDefaultTargetFramework>net10.0</BaxyDefaultTargetFramework>
    <BaxyWindowsTargetFramework>net10.0-windows10.0.19041.0</BaxyWindowsTargetFramework>
    <BaxyRuntimeIdentifier>win-x64</BaxyRuntimeIdentifier>
    <BaxyDevelopmentConfiguration>Release</BaxyDevelopmentConfiguration>
    <TargetFramework>$(BaxyDefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- FIR1: the public keys whose signature an update needs (src/Baxy.Core/Operations/ReleaseSignature.cs), built into
         baxy-core and the installer. A test build names its own with -p:BaxyUpdateKeys=<file>. -->
    <BaxyUpdateKeys Condition="'$(BaxyUpdateKeys)' == ''">$(MSBuildThisFileDirectory)release-keys\update-keys.pem</BaxyUpdateKeys>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)tests\hang.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
