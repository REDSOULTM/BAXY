<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Baxy.Setup</AssemblyName>
    <RootNamespace>Baxy.Setup</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <InvariantGlobalization>false</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="/Brepro" />
  </ItemGroup>
  <ItemGroup Condition="'$(BaxyEmbeddedPackage)' != '' and '$(BaxyEmbeddedPackageAttestation)' != ''">
    <EmbeddedResource Include="$(BaxyEmbeddedPackage)" LogicalName="Baxy.Setup.Payload.zip" />
    <EmbeddedResource Include="$(BaxyEmbeddedPackageAttestation)" LogicalName="Baxy.Setup.Payload.attestation.json" />
  </ItemGroup>
  <!-- The Field UI's built assets carry content hashes in their names: the package contract takes them from the build
       it ships (PackageContract.PayloadPaths), never from a list kept by hand. BaxyFieldUiAssetDirectory only lets a
       test build stand in another asset set. -->
  <Target Name="BaxyFieldUiAssetContract" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BaxyFieldUiAssetSource>$(IntermediateOutputPath)FieldUiAssets.g.cs</BaxyFieldUiAssetSource>
      <BaxyFieldUiAssetDirectory Condition="'$(BaxyFieldUiAssetDirectory)' == ''">$(MSBuildThisFileDirectory)..\Baxy.FieldUi\dist\assets\</BaxyFieldUiAssetDirectory>
    </PropertyGroup>
    <ItemGroup>
      <BaxyFieldUiAsset Include="$(BaxyFieldUiAssetDirectory)*" />
      <BaxyFieldUiAssetLine Include="@(BaxyFieldUiAsset->'&quot;FieldUi/assets/%(Filename)%(Extension)&quot;,')" />
    </ItemGroup>
    <Error Condition="'@(BaxyFieldUiAsset)' == ''"
           Text="src/Baxy.FieldUi/dist/assets is empty: build the Field UI (pnpm build) before Baxy.Setup." />
    <WriteLinesToFile File="$(BaxyFieldUiAssetSource)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by Baxy.Setup.csproj from src/Baxy.FieldUi/dist/assets.;namespace Baxy.Setup%3B;internal static class FieldUiAssets;{;internal static readonly string[] Paths =;[;@(BaxyFieldUiAssetLine);]%3B;}" />
    <ItemGroup>
      <Compile Include="$(BaxyFieldUiAssetSource)" />
      <FileWrites Include="$(BaxyFieldUiAssetSource)" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateBaxyEmbeddedResourcePair" BeforeTargets="PrepareForBuild"
          Condition="('$(BaxyEmbeddedPackage)' == '') != ('$(BaxyEmbeddedPackageAttestation)' == '')">
    <Error Text="BaxyEmbeddedPackage and BaxyEmbeddedPackageAttestation must be supplied together." />
  </Target>
  <Target Name="RequireBaxyEmbeddedResourcesForPublish" BeforeTargets="Publish"
          Condition="'$(BaxyDevelopmentPayloadlessPublish)' != 'true'">
    <Error Condition="'$(BaxyEmbeddedPackage)' == '' or '$(BaxyEmbeddedPackageAttestation)' == ''"
           Text="Delivery publish requires both canonical BAXY embedded-package resources." />
  </Target>
</Project>
