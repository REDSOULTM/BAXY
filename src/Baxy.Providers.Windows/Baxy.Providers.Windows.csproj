<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(BaxyWindowsTargetFramework)</TargetFramework>
    <AssemblyName>Baxy.Providers.Windows</AssemblyName>
    <RootNamespace>Baxy.Providers.Windows</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Baxy.Contracts\Baxy.Contracts.csproj" />
    <ProjectReference Include="..\Baxy.Kernel\Baxy.Kernel.csproj" />
    <ProjectReference Include="..\Baxy.Security.Windows\Baxy.Security.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="External\SpotifyDesktopAutomation.ps1"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="SpotifyDesktopAutomation.ps1" />
    <None Include="External\KnownFolderOpen.ps1"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="KnownFolderOpen.ps1" />
    <None Include="External\KnownFileOpen.ps1"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="KnownFileOpen.ps1" />
    <None Include="External\DesktopSelectAll.ps1"
            CopyToOutputDirectory="PreserveNewest"
            TargetPath="DesktopSelectAll.ps1" />
    <None Include="External\DesktopKeyPress.ps1"
            CopyToOutputDirectory="PreserveNewest"
            TargetPath="DesktopKeyPress.ps1" />
    <None Include="External\DesktopUiaWorker.ps1"
            CopyToOutputDirectory="PreserveNewest"
            TargetPath="DesktopUiaWorker.ps1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\baxy_mind\data\keypad_keys.v1.json" LogicalName="Baxy.Providers.Windows.KeypadKeys.json" />
    <EmbeddedResource Include="..\baxy_mind\data\documentless_applications.v1.json" LogicalName="Baxy.Providers.Windows.DocumentlessApplications.json" />
    <EmbeddedResource Include="..\baxy_mind\data\render_surface_classes.v1.json" LogicalName="Baxy.Providers.Windows.RenderSurfaceClasses.json" />
    <EmbeddedResource Include="..\baxy_mind\data\search_addresses.v1.json" LogicalName="Baxy.Providers.Windows.SearchAddresses.json" />
    <EmbeddedResource Include="..\baxy_mind\data\client_cold_start.v1.json" LogicalName="Baxy.Providers.Windows.ClientColdStart.json" />
    <!-- WEB1: los lugares de GeoNames (CC BY 4.0) que leen el clima y la hora de otro lugar (scripts/datos/geonames_lugares.py). -->
    <EmbeddedResource Include="Data\geonames_places.v1.tsv.gz" LogicalName="Baxy.Providers.Windows.GeoNamesPlaces.tsv.gz" />
  </ItemGroup>
</Project>
