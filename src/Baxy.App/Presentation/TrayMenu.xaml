<Window x:Class="Baxy.App.Presentation.TrayMenu"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAXY"
        Width="264"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Bone" Color="#D8DCE6" />
    <SolidColorBrush x:Key="Muted" Color="#8A95AD" />
    <SolidColorBrush x:Key="Hair" Color="#252E3D" />
    <SolidColorBrush x:Key="Carmine" Color="#B83A4A" />
    <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A menu row: a glyph, its words and, on hover or keyboard focus, the carmine bar of the design v4. -->
    <Style x:Key="Row" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Bone}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Height="36" CornerRadius="3" Background="Transparent" Margin="6,1">
              <Grid>
                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="1.5" Margin="0,8"
                        Background="{StaticResource Carmine}" Opacity="0" />
                <StackPanel Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                  <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                             FontFamily="{StaticResource Glyphs}" FontSize="14" Width="22"
                             Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                  <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#161B22" />
                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                <Setter TargetName="Glyph" Property="Foreground" Value="#E55366" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#161B22" />
                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                <Setter TargetName="Glyph" Property="Foreground" Value="#E55366" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="12" CornerRadius="6" Background="#0F1419" BorderBrush="{StaticResource Hair}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
    </Border.Effect>
    <StackPanel>
      <!-- header: the icon, BAXY in capitals and what it is doing now -->
      <Border Padding="14,12,14,10" BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Source="pack://application:,,,/Assets/baxy.ico" Width="28" Height="28"
                 RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="BAXY" Foreground="{StaticResource Bone}" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontWeight="SemiBold" FontSize="14">
              <TextBlock.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35" Color="#B83A4A" />
              </TextBlock.Effect>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#7FD1A8" VerticalAlignment="Center" />
              <TextBlock x:Name="StateText" Margin="6,0,0,0" Foreground="{StaticResource Muted}" FontSize="11.5"
                         FontFamily="Segoe UI Variable Text, Segoe UI" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Margin="0,6">
        <Button x:Name="OpenRow" Style="{StaticResource Row}" Tag="&#xE8A7;" Click="OnOpen" />
        <Button x:Name="ListenRow" Style="{StaticResource Row}" Tag="&#xE720;" Click="OnListen" />
        <Button x:Name="PowerRow" Style="{StaticResource Row}" Tag="&#xE7E8;" Click="OnPower" />
        <Border Height="1" Margin="14,6" Background="{StaticResource Hair}" />
        <Button x:Name="ExitRow" Style="{StaticResource Row}" Tag="&#xE8BB;" Click="OnExit" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
