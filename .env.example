# Carter Agent — ejemplo de configuración por variables de entorno.
# Copiá este archivo a .env (o exportá las variables en tu shell). Todas tienen
# un default razonable: solo necesitás setear las que querés cambiar.
# En PowerShell: $env:GEMMA4_MODEL_PATH = "C:\ruta\al\modelo.gguf"

# --- Modelo y servidor LLM -------------------------------------------------
# Ruta al GGUF del modelo. Default: models/E2B/gemma-4-E2B-it-Q4_K_M.gguf
# GEMMA4_MODEL_PATH=C:\ruta\models\E2B\gemma-4-E2B-it-Q4_K_M.gguf

# Ruta al binario llama-server.exe (build con CUDA). Default lo busca en
# C:\llamacpp-cuda\bin\llama-server.exe.
# GEMMA4_LLAMA_SERVER_EXE=C:\llamacpp-cuda\bin\llama-server.exe

# Perfil activo. Default: vram4 (target 4 GB VRAM). Otros: standby, cpu.
# GEMMA4_DEFAULT_PROFILE=vram4

# Tamaño del context window (tokens). Default del perfil vram4: 12288.
# GEMMA4_AGENT_CONTEXT=12288

# --- Generación ------------------------------------------------------------
# Máximo de tokens por respuesta. Default: 1280.
# GEMMA4_AGENT_MAX_TOKENS=1280

# Temperatura / top_p / top_k del muestreo (defaults conservadores).
# GEMMA4_AGENT_TEMPERATURE=0.7
# GEMMA4_AGENT_TOP_P=0.9

# --- Funcionalidades (toggles) ---------------------------------------------
# Memoria persistente del agente (gustos, hechos). Default: on.
# GEMMA4_AGENT_MEMORY=1

# Cliente MCP (herramientas externas). Default: off. Requiere declarar
# servidores en ~/.gemma4/mcp_servers.json antes de activar.
# GEMMA4_MCP=0

# Procesador de archivos unificado (feature opt-in). Default: off.
# GEMMA4_FILE_PROCESSOR=0

# --- Integraciones opcionales (sin estos, las tools devuelven needs_user) --
# Microsoft Graph token para envío real de email (email tool). Sin esto, la
# tool redacta el borrador pero no envía.
# GEMMA4_GRAPH_TOKEN=

# Personal Access Token de GitHub (solo si usás el servidor MCP de GitHub).
# GITHUB_PERSONAL_ACCESS_TOKEN=
