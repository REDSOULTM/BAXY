<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\TestInfrastructure\NtfsTestJunction.cs" Link="TestInfrastructure\NtfsTestJunction.cs" />
    <!-- The App has no test project: its notice of a silent turn and its view of a look are one file each with no App
         dependency. -->
    <Compile Include="..\..\src\Baxy.App\SilenceNotice.cs" Link="App\SilenceNotice.cs" />
    <Compile Include="..\..\src\Baxy.App\ScreenViewProjection.cs" Link="App\ScreenViewProjection.cs" />
    <!-- The heartbeat's reading of the person's absence and return: one file with no App dependency. -->
    <Compile Include="..\..\src\Baxy.App\AwayWatch.cs" Link="App\AwayWatch.cs" />
    <!-- When BAXY's line is the confirmation of the call that waits: one file with no App dependency. -->
    <Compile Include="..\..\src\Baxy.App\ConfirmationAsk.cs" Link="App\ConfirmationAsk.cs" />
    <!-- When a turn of the tool loop takes no more calls: one file with no App dependency. -->
    <Compile Include="..\..\src\Baxy.App\TurnClosing.cs" Link="App\TurnClosing.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <ProjectReference Include="..\..\src\Baxy.Contracts\Baxy.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Baxy.Kernel\Baxy.Kernel.csproj" />
  </ItemGroup>
</Project>
