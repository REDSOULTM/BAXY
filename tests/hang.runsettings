<?xml version="1.0" encoding="utf-8"?>
<!-- N3 (2026-11-04): a suite stopped once with no CPU and said nothing for half an hour. A test that does not end within
     this time aborts its run and the run names it (Sequence file, console). No dump: it would hold the desktop's data. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="blame" enabled="True">
        <Configuration>
          <CollectDumpOnTestSessionHang TestTimeout="5min" HangDumpType="None" />
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
